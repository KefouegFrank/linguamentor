# LinguaMentor — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
#    cp .env.example .env
# Then edit .env with your credentials.
#
# Never commit .env — it is gitignored.
# ============================================================

# ── Database (PostgreSQL) ──────────────────────────────────────────
# These match the defaults in docker-compose.yml.
LM_DB_HOST=localhost
LM_DB_PORT=5433
LM_DB_NAME=linguamentor_prod
LM_DB_USER=linguamentor_admin
LM_DB_PASSWORD=your_db_password_here
LM_DATABASE_URL=postgresql://linguamentor_admin:your_db_password_here@localhost:5433/linguamentor_prod

# ── Redis ──────────────────────────────────────────────────────────
LM_REDIS_URL=redis://localhost:6380

# ── JWT (RS256 — asymmetric) ──────────────────────────────────────
# Generate the key pair with: python scripts/generate_jwt_keys.py
LM_JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
LM_JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
LM_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
LM_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Service Ports ─────────────────────────────────────────────────
LM_APP_PORT=3000
LM_AI_SERVICE_PORT=8000

# ── Service URLs ──────────────────────────────────────────────────
# Solo-dev topology: all AI engines run in one Python service.
# The gateway proxies all /api/v1/* routes here.
LM_AI_SERVICE_URL=http://localhost:8000
LM_FRONTEND_URL=http://localhost:3001

# ── AI Providers ──────────────────────────────────────────────────
# Leave empty to disable. At least one is required for AI features.
# Set LM_USE_MOCK_PROVIDER=true for local testing without API keys.
LM_OPENAI_API_KEY=
LM_ANTHROPIC_API_KEY=
LM_GROQ_API_KEY=
LM_GEMINI_API_KEY=

# ── Calibration ───────────────────────────────────────────────────
LM_CALIBRATION_VERSION=v1.0-dev
LM_USE_MOCK_PROVIDER=false

# ── App ────────────────────────────────────────────────────────────
LM_APP_ENV=development
LM_APP_DEBUG=true
