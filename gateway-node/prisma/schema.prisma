datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  ENGLISH
  FRENCH
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      LearnerProfile?
  diagnosticSessions DiagnosticSession[]

  @@map("users")
}

model LearnerProfile {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLanguage Language
  currentLevel   ProficiencyLevel @default(A1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  skillVector    SkillVector?

  @@map("learner_profiles")
}

model SkillVector {
  id                 String         @id @default(uuid()) @db.Uuid
  profileId          String         @unique @db.Uuid
  profile            LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  grammarScore       Float          @default(0.0)
  vocabularyScore    Float          @default(0.0)
  pronunciationScore Float          @default(0.0)
  coherenceScore     Float          @default(0.0)
  updatedAt          DateTime       @updatedAt

  @@map("skill_vectors")
}

model DiagnosticSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SessionStatus @default(IN_PROGRESS)
  
  // Storing the generated JSON question structure securely as a native DB JSONB block
  generatedContent Json
  
  // Storing user answers once submitted
  userAnswers      Json?
  
  // Scoring results summary
  grammarScore     Float?
  vocabularyScore  Float?
  feedbackText     String?       @db.Text
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("diagnostic_sessions")
}

model AIModelRun {
  id           String   @id @default(uuid()) @db.Uuid
  promptHash   String   @db.VarChar(64)
  modelName    String
  modelVersion String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@map("ai_model_runs")
}