datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  ENGLISH
  FRENCH
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      LearnerProfile?

  @@map("users")
}

model LearnerProfile {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetLanguage Language
  currentLevel   ProficiencyLevel @default(A1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  skillVector    SkillVector?

  @@map("learner_profiles")
}

model SkillVector {
  id                 String         @id @default(uuid()) @db.Uuid
  profileId          String         @unique @db.Uuid
  profile            LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  grammarScore       Float          @default(0.0)
  vocabularyScore    Float          @default(0.0)
  pronunciationScore Float          @default(0.0)
  coherenceScore     Float          @default(0.0)
  updatedAt          DateTime       @updatedAt

  @@map("skill_vectors")
}